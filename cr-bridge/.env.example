# cr-bridge settings. Copy to .env (testing) or /etc/closet-republic/bridge.env (production).
CR_BRIDGE_HOST=127.0.0.1
CR_BRIDGE_PORT=40007
# Shared with the forum plugin (CR_BRIDGE_SECRET there) and the main site's BMC forwarder.
CR_BRIDGE_SECRET=
# For POST /admin/run/<ingest|reconcile|roles>
CR_ADMIN_TOKEN=
CR_BRIDGE_DB=./data/bridge.db
# true = log every write instead of doing it
CR_DRY_RUN=false

# NodeBB: Write API master token from ACP > Settings > API Access, and the uid of the
# "reddit-bridge" administrator account the bridge acts as.
NODEBB_URL=http://127.0.0.1:40006
NODEBB_PUBLIC_URL=https://forum.closetrepublic.com
NODEBB_TOKEN=
CR_BRIDGE_UID=

# Reddit: devvit | api | rss | off (see docs/reddit-devvit.md for devvit)
REDDIT_MODE=off
REDDIT_SUBREDDIT=closetrepublic
# devvit mode: address from the subreddit menu "Forum bridge address", and the app token
DEVVIT_URL=
DEVVIT_TOKEN=
# api mode: Reddit API key ("script" app) and bot account
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=server:closetrepublic-bridge:0.1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_MAX_QPM=60

# Discord bot (read-only; needs Server Members Intent)
DISCORD_BOT_TOKEN=
# Defaults to discordGuildId in config/roles.json
DISCORD_GUILD_ID=

# Only if Buy Me a Coffee calls the bridge directly instead of through the main site
BMC_WEBHOOK_SECRET=
BMC_ACCEPT_TEST_EVENTS=false
