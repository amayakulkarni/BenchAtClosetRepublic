{
  "name": "cr-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Closet Republic bridge: Reddit sync, Discord and Buy Me a Coffee role tiers for the NodeBB forum",
  "type": "module",
  "main": "src/index.js",
  "engines": { "node": ">=22" },
